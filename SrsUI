local SrsUI = {}
SrsUI.__index = SrsUI

-- Services
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer

-- Constants
local DEFAULT_THEME = {
    Primary = Color3.fromRGB(61, 133, 224),   -- Main accent color
    Background = Color3.fromRGB(25, 25, 35),  -- Background color
    Secondary = Color3.fromRGB(35, 35, 45),   -- Secondary background color
    Text = Color3.fromRGB(255, 255, 255),     -- Text color
    Disabled = Color3.fromRGB(100, 100, 100), -- Disabled element color
    Error = Color3.fromRGB(255, 75, 75),      -- Error/negative color
    Success = Color3.fromRGB(75, 255, 75),    -- Success/positive color
    Transparency = 0.05,                      -- Background transparency
    CornerRadius = 0.25,                      -- Corner radius (0-0.5)
}

-- Utility functions
local function createObject(className, properties)
    local obj = Instance.new(className)
    for prop, value in pairs(properties) do
        obj[prop] = value
    end
    return obj
end

local function makeRound(instance, radius)
    local corner = createObject("UICorner", {
        CornerRadius = UDim.new(radius, 0)
    })
    corner.Parent = instance
    return corner
end

local function makeShadow(instance)
    local shadow = createObject("ImageLabel", {
        Name = "Shadow",
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1, 45, 1, 45),
        ZIndex = -1,
        Image = "rbxassetid://5554236805",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = 0.4
    })
    shadow.Parent = instance
    return shadow
end

-- Create main UI library
function SrsUI.new(title, options)
    options = options or {}
    
    local theme = {}
    for k, v in pairs(DEFAULT_THEME) do
        theme[k] = options.theme and options.theme[k] or v
    end
    
    local screenGui = createObject("ScreenGui", {
        Name = options.name or "SrsUI",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    })
    
    -- Try to parent to CoreGui for persistence, fallback to PlayerGui
    local success = pcall(function()
        screenGui.Parent = game:GetService("CoreGui")
    end)
    
    if not success then
        screenGui.Parent = Player:WaitForChild("PlayerGui")
    end
    
    -- Main frame
    local mainFrame = createObject("Frame", {
        Name = "MainFrame",
        Size = UDim2.new(0, options.width or 300, 0, options.height or 350),
        Position = options.position or UDim2.new(0.5, -(options.width or 300)/2, 0.5, -(options.height or 350)/2),
        BackgroundColor3 = theme.Background,
        BackgroundTransparency = theme.Transparency,
        BorderSizePixel = 0,
        Active = true,
        Parent = screenGui
    })
    
    makeRound(mainFrame, theme.CornerRadius)
    makeShadow(mainFrame)
    
    -- Title bar
    local titleBar = createObject("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = theme.Primary,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Parent = mainFrame
    })
    
    makeRound(titleBar, theme.CornerRadius)
    
    -- Fix corner overlap
    local cornerFix = createObject("Frame", {
        Name = "CornerFix",
        Size = UDim2.new(1, 0, 0.5, 0),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = theme.Primary,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        ZIndex = 0,
        Parent = titleBar
    })
    
    -- Title text
    local titleText = createObject("TextLabel", {
        Name = "TitleText",
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = title or "SrsUI",
        TextColor3 = theme.Text,
        TextSize = 18,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar
    })
    
    -- Close button
    local closeButton = createObject("ImageButton", {
        Name = "CloseButton",
        Size = UDim2.new(0, 26, 0, 26),
        Position = UDim2.new(1, -33, 0, 7),
        BackgroundTransparency = 1,
        Image = "rbxassetid://7072725342",
        ImageColor3 = theme.Text,
        Parent = titleBar
    })
    
    -- Contents frame (container for all UI elements)
    local contentsFrame = createObject("ScrollingFrame", {
        Name = "ContentsFrame",
        Size = UDim2.new(1, -20, 1, -50),
        Position = UDim2.new(0, 10, 0, 45),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = theme.Primary,
        CanvasSize = UDim2.new(0, 0, 0, 0), -- Will be updated as elements are added
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = mainFrame
    })
    
    -- Make UI draggable
    local dragging, dragInput, dragStart, startPos
    
    local function updateDrag(input)
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
    
    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    titleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            updateDrag(input)
        end
    end)
    
    -- Close button functionality
    closeButton.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)
    
    -- Create UI instance and set properties
    local ui = setmetatable({
        ScreenGui = screenGui,
        MainFrame = mainFrame,
        ContentsFrame = contentsFrame,
        TitleBar = titleBar,
        Elements = {},
        Theme = theme,
        ElementCount = 0,
        Sections = {}
    }, SrsUI)
    
    return ui
end

-- Add a section to the UI
function SrsUI:AddSection(title)
    self.ElementCount = self.ElementCount + 1
    local yPos = (self.ElementCount - 1) * 25
    
    -- Create section container
    local section = createObject("Frame", {
        Name = "Section_" .. title,
        Size = UDim2.new(1, 0, 0, 35), -- Initial size, will grow as elements are added
        Position = UDim2.new(0, 0, 0, yPos),
        BackgroundTransparency = 1,
        Parent = self.ContentsFrame
    })
    
    -- Add section title
    local sectionTitle = createObject("TextLabel", {
        Name = "SectionTitle",
        Size = UDim2.new(1, 0, 0, 25),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = self.Theme.Primary,
        TextSize = 16,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = section
    })
    
    -- Add divider
    local divider = createObject("Frame", {
        Name = "Divider",
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 0, 25),
        BackgroundColor3 = self.Theme.Primary,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        Parent = section
    })
    
    -- Initialize section data
    local sectionData = {
        Frame = section,
        Title = sectionTitle,
        Elements = {},
        ElementCount = 0
    }
    
    self.Sections[title] = sectionData
    self.ElementCount = self.ElementCount + 1
    
    return sectionData
end

-- Helper function to resize sections as elements are added
local function updateSectionSize(section)
    local newHeight = 35 -- Base height with title and padding
    
    for _, element in ipairs(section.Elements) do
        newHeight = newHeight + element.Height
    end
    
    section.Frame.Size = UDim2.new(1, 0, 0, newHeight)
end

-- Helper function to position elements correctly
local function positionSectionElements(section)
    local yOffset = 35 -- Start below section title
    
    for _, element in ipairs(section.Elements) do
        element.Frame.Position = UDim2.new(0, 0, 0, yOffset)
        yOffset = yOffset + element.Height
    end
    
    updateSectionSize(section)
end

-- Add a label to a section
function SrsUI:AddLabel(section, text)
    if not section then return nil end
    
    local labelHeight = 25
    local label = createObject("TextLabel", {
        Name = "Label_" .. text,
        Size = UDim2.new(1, 0, 0, labelHeight),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = section.Frame
    })
    
    local elementData = {
        Type = "Label",
        Frame = label,
        Height = labelHeight
    }
    
    table.insert(section.Elements, elementData)
    section.ElementCount = section.ElementCount + 1
    
    positionSectionElements(section)
    return elementData
end

-- Add a button to a section
function SrsUI:AddButton(section, text, callback)
    if not section then return nil end
    
    local buttonHeight = 30
    local button = createObject("TextButton", {
        Name = "Button_" .. text,
        Size = UDim2.new(1, 0, 0, buttonHeight),
        BackgroundColor3 = self.Theme.Primary,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        Parent = section.Frame
    })
    
    makeRound(button, 0.15)
    
    -- Button hover and click effects
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundTransparency = 0.1}):Play()
    end)
    
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundTransparency = 0.2}):Play()
    end)
    
    button.MouseButton1Down:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1), {BackgroundTransparency = 0.3}):Play()
    end)
    
    button.MouseButton1Up:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.1), {BackgroundTransparency = 0.1}):Play()
    end)
    
    if callback then
        button.MouseButton1Click:Connect(function()
            callback()
        end)
    end
    
    local elementData = {
        Type = "Button",
        Frame = button,
        Height = buttonHeight + 5, -- Add padding
        Button = button,
        SetText = function(newText)
            button.Text = newText
        end
    }
    
    table.insert(section.Elements, elementData)
    section.ElementCount = section.ElementCount + 1
    
    positionSectionElements(section)
    return elementData
end

-- Add a toggle to a section
function SrsUI:AddToggle(section, text, default, callback)
    if not section then return nil end
    
    local toggleHeight = 30
    local toggleContainer = createObject("Frame", {
        Name = "Toggle_" .. text,
        Size = UDim2.new(1, 0, 0, toggleHeight),
        BackgroundTransparency = 1,
        Parent = section.Frame
    })
    
    local toggleLabel = createObject("TextLabel", {
        Name = "Label",
        Size = UDim2.new(0.7, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = toggleContainer
    })
    
    local toggleButton = createObject("TextButton", {
        Name = "Button",
        Size = UDim2.new(0, 40, 0, 20),
        Position = UDim2.new(1, -45, 0.5, -10),
        BackgroundColor3 = default and self.Theme.Primary or Color3.fromRGB(80, 80, 80),
        BorderSizePixel = 0,
        Text = "",
        Parent = toggleContainer
    })
    
    makeRound(toggleButton, 0.5)
    
    local toggleKnob = createObject("Frame", {
        Name = "Knob",
        Size = UDim2.new(0, 16, 0, 16),
        Position = default and UDim2.new(0, 22, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = toggleButton
    })
    
    makeRound(toggleKnob, 1)
    
    local toggle = {
        Type = "Toggle",
        Frame = toggleContainer,
        Height = toggleHeight + 5, -- Add padding
        Button = toggleButton,
        Knob = toggleKnob,
        Enabled = default or false,
        Toggle = function(self, value)
            if value ~= nil then
                self.Enabled = value
            else
                self.Enabled = not self.Enabled
            end
            
            local targetPosition = self.Enabled and UDim2.new(0, 22, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
            local targetColor = self.Enabled and toggle.UI.Theme.Primary or Color3.fromRGB(80, 80, 80)
            
            TweenService:Create(toggleKnob, TweenInfo.new(0.2), {Position = targetPosition}):Play()
            TweenService:Create(toggleButton, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
            
            if callback then
                callback(self.Enabled)
            end
            
            return self.Enabled
        end,
        GetValue = function(self)
            return self.Enabled
        end
    }
    
    toggle.UI = self
    
    toggleButton.MouseButton1Click:Connect(function()
        toggle:Toggle()
    end)
    
    local elementData = toggle
    
    table.insert(section.Elements, elementData)
    section.ElementCount = section.ElementCount + 1
    
    positionSectionElements(section)
    return elementData
end

-- Add a slider to a section
function SrsUI:AddSlider(section, text, min, max, default, callback)
    if not section then return nil end
    
    local sliderHeight = 50
    local sliderContainer = createObject("Frame", {
        Name = "Slider_" .. text,
        Size = UDim2.new(1, 0, 0, sliderHeight),
        BackgroundTransparency = 1,
        Parent = section.Frame
    })
    
    local sliderLabel = createObject("TextLabel", {
        Name = "Label",
        Size = UDim2.new(0.6, 0, 0, 25),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = sliderContainer
    })
    
    local sliderValue = createObject("TextLabel", {
        Name = "Value",
        Size = UDim2.new(0.4, 0, 0, 25),
        Position = UDim2.new(0.6, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = sliderContainer
    })
    
    local sliderTrack = createObject("TextButton", {
        Name = "Track",
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 0, 30),
        BackgroundColor3 = Color3.fromRGB(80, 80, 80),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = sliderContainer
    })
    
    makeRound(sliderTrack, 1)
    
    local sliderFill = createObject("Frame", {
        Name = "Fill",
        Size = UDim2.new(0, 0, 1, 0), -- Will be updated based on value
        BackgroundColor3 = self.Theme.Primary,
        BorderSizePixel = 0,
        Parent = sliderTrack
    })
    
    makeRound(sliderFill, 1)
    
    local sliderKnob = createObject("Frame", {
        Name = "Knob",
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 0, 0.5, -8), -- Will be updated based on value
        BackgroundColor3 = self.Theme.Primary,
        BorderSizePixel = 0,
        Parent = sliderTrack
    })
    
    makeRound(sliderKnob, 1)
    
    -- Normalize the initial value
    local normalized = (default - min) / (max - min)
    sliderFill.Size = UDim2.new(normalized, 0, 1, 0)
    sliderKnob.Position = UDim2.new(normalized, -8, 0.5, -8)
    
    local slider = {
        Type = "Slider",
        Frame = sliderContainer,
        Height = sliderHeight + 5, -- Add padding
        Track = sliderTrack,
        Fill = sliderFill,
        Knob = sliderKnob,
        ValueLabel = sliderValue,
        Min = min,
        Max = max,
        Value = default,
        SetValue = function(self, value)
            local newValue = math.clamp(value, self.Min, self.Max)
            self.Value = newValue
            
            local normalized = (newValue - self.Min) / (self.Max - self.Min)
            TweenService:Create(sliderFill, TweenInfo.new(0.1), {Size = UDim2.new(normalized, 0, 1, 0)}):Play()
            TweenService:Create(sliderKnob, TweenInfo.new(0.1), {Position = UDim2.new(normalized, -8, 0.5, -8)}):Play()
            
            sliderValue.Text = tostring(math.round(newValue))
            
            if callback then
                callback(newValue)
            end
            
            return self.Value
        end,
        GetValue = function(self)
            return self.Value
        end
    }
    
    -- Handle slider input
    local isDragging = false
    
    sliderTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            local position = input.Position.X
            local absolutePos = sliderTrack.AbsolutePosition.X
            local absoluteSize = sliderTrack.AbsoluteSize.X
            
            local relativeX = math.clamp((position - absolutePos) / absoluteSize, 0, 1)
            local newValue = min + (relativeX * (max - min))
            
            slider:SetValue(newValue)
        end
    end)
    
    sliderTrack.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local position = input.Position.X
            local absolutePos = sliderTrack.AbsolutePosition.X
            local absoluteSize = sliderTrack.AbsoluteSize.X
            
            local relativeX = math.clamp((position - absolutePos) / absoluteSize, 0, 1)
            local newValue = min + (relativeX * (max - min))
            
            slider:SetValue(newValue)
        end
    end)
    
    local elementData = slider
    
    table.insert(section.Elements, elementData)
    section.ElementCount = section.ElementCount + 1
    
    positionSectionElements(section)
    return elementData
end

-- Add a status indicator to a section
function SrsUI:AddStatus(section, text, defaultColor)
    if not section then return nil end
    
    local statusHeight = 30
    local statusContainer = createObject("Frame", {
        Name = "Status_" .. text,
        Size = UDim2.new(1, 0, 0, statusHeight),
        BackgroundTransparency = 1,
        Parent = section.Frame
    })
    
    local indicator = createObject("Frame", {
        Name = "Indicator",
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, 5, 0.5, -6),
        BackgroundColor3 = defaultColor or Color3.fromRGB(255, 75, 75),
        BorderSizePixel = 0,
        Parent = statusContainer
    })
    
    makeRound(indicator, 1)
    
    local statusLabel = createObject("TextLabel", {
        Name = "Label",
        Size = UDim2.new(1, -25, 1, 0),
        Position = UDim2.new(0, 25, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = self.Theme.Text,
        TextSize = 14,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = statusContainer
    })
    
    local status = {
        Type = "Status",
        Frame = statusContainer,
        Height = statusHeight,
        Indicator = indicator,
        Label = statusLabel,
        SetStatus = function(self, text, color)
            if text then
                statusLabel.Text = text
            end
            
            if color then
                TweenService:Create(indicator, TweenInfo.new(0.3), {BackgroundColor3 = color}):Play()
            end
        end
    }
    
    local elementData = status
    
    table.insert(section.Elements, elementData)
    section.ElementCount = section.ElementCount + 1
    
    positionSectionElements(section)
    return elementData
end

-- Add a statistics display to a section
function SrsUI:AddStats(section, stats)
    if not section then return nil end
    
    local statsHeight = #stats * 25 + 5
    local statsContainer = createObject("Frame", {
        Name = "StatsContainer",
        Size = UDim2.new(1, 0, 0, statsHeight),
        BackgroundTransparency = 1,
        Parent = section.Frame
    })
    
    local statElements = {}
    
    for i, stat in ipairs(stats) do
        local statLabel = createObject("TextLabel", {
            Name = "Stat_" .. stat.name,
            Size = UDim2.new(0.5, -5, 0, 20),
            Position = UDim2.new(0, 5, 0, (i-1) * 25 + 5),
            BackgroundTransparency = 1,
            Text = stat.name .. ":",
            TextColor3 = self.Theme.Text,
            TextSize = 14,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = statsContainer
        })
        
        local statValue = createObject("TextLabel", {
            Name = "Value_" .. stat.name,
            Size = UDim2.new(0.5, -5, 0, 20),
            Position = UDim2.new(0.5, 0, 0, (i-1) * 25 + 5),
            BackgroundTransparency = 1,
            Text = stat.value or "0",
            TextColor3 = self.Theme.Text,
            TextSize = 14,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = statsContainer
        })
        
        statElements[stat.name] = {
            Label = statLabel,
            Value = statValue,
            Update = function(newValue)
                statValue.Text = tostring(newValue)
            end
        }
    end
    
    local stats = {
        Type = "Stats",
        Frame = statsContainer,
        Height = statsHeight + 5,
        Elements = statElements,
        UpdateStat = function(self, name, value)
            if self.Elements[name] then
                self.Elements[name].Update(value)
            end
        end
    }
    
    local elementData = stats
    
    table.insert(section.Elements, elementData)
    section.ElementCount = section.ElementCount + 1
    
    positionSectionElements(section)
    return elementData
end

-- Add a notification system
function SrsUI:ShowNotification(text, duration, type)
    duration = duration or 3
    type = type or "info"
    
    local colors = {
        info = self.Theme.Primary,
        success = self.Theme.Success,
        error = self.Theme.Error
    }
    
    local notifColor = colors[type] or colors.info
    
    -- Create notification GUI
    local notifGui = createObject("ScreenGui", {
        Name = "Notification",
        ResetOnSpawn = false
    })
    
    pcall(function() notifGui.Parent = game:GetService("CoreGui") end)
    if not notifGui.Parent then
        notifGui.Parent = Player:WaitForChild("PlayerGui")
    end
    
    local notifFrame = createObject("Frame", {
        Size = UDim2.new(0, 250, 0, 60),
        Position = UDim2.new(0.5, -125, 0, -70),
        BackgroundColor3 = self.Theme.Background,
        BackgroundTransparency = self.Theme.Transparency,
        BorderSizePixel = 0,
        Parent = notifGui
    })
    
    makeRound(notifFrame, 0.2)
    makeShadow(notifFrame)
    
    local notifBar = createObject("Frame", {
        Size = UDim2.new(0.02, 0, 1, 0),
        BackgroundColor3 = notifColor,
        BorderSizePixel = 0,
        Parent = notifFrame
    })
    
    makeRound(notifBar, 0.2)
    
    local notifText = createObject("TextLabel", {
        Size = UDim2.new(0.98, -10, 1, 0),
        Position = UDim2.new(0.02, 5, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = self.Theme.Text,
        TextSize = 16,
        Font = Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notifFrame
    })
    
    -- Animation
    local slideIn = TweenService:Create(
        notifFrame,
        TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = UDim2.new(0.5, -125, 0, 20)}
    )
    
    slideIn:Play()
    
    -- Slide out after duration
    task.delay(duration, function()
        local slideOut = TweenService:Create(
            notifFrame,
            TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {Position = UDim2.new(0.5, -125, 0, -70)}
        )
        
        slideOut:Play()
        
        slideOut.Completed:Connect(function()
            notifGui:Destroy()
        end)
    end)
end

-- Return library
return SrsUI
